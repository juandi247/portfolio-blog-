---
import '../styles/global.css';
interface Props { title?: string; active?: 'home' | 'blog' }
const { title = 'Nico Ramírez – Software engineer', active = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body>
    <header class="top">
      <div>
        <a href="/" style="text-decoration:none"><b>nico.</b></a>
        <nav>
          <a href="/" class={active === 'home' ? 'on' : ''}>Home</a>
          <a href="/blog" class={active === 'blog' ? 'on' : ''}>Blog</a>
          <a href="/#projects">Projects</a>
          <a href="/#experience">Experience</a>
          <a href="/#education">Education</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main class="go"><slot /></main>
  </body>
</html>
